# Copy to whatsapp-service/.env and fill in your values
# Run: cp .env.example .env

# Port for local Express + Socket.IO server (frontend connects here)
PORT=3002

# Cloudflare Worker URL — all WhatsApp data is stored in D1 via the worker
WA_WORKER_URL=http://localhost:8787

# Shared secret between this service and the worker (x-wa-secret header)
# Must match the WA_SHARED_SECRET in worker/.dev.vars / Cloudflare secrets
WA_SHARED_SECRET=dev-local-secret

# Stable session identifier used as a D1 partition key
WA_SESSION_ID=wa-tools

# SLA breach threshold in seconds (default 15 min)
SLA_THRESHOLD_SECONDS=900

# Number of chats/messages to backfill on first connect
INITIAL_MESSAGE_SYNC_CHATS=20
INITIAL_MESSAGE_SYNC_LIMIT=20
