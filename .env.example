R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_BASE_URL=https://pub-your-bucket-id.r2.dev
R2_DB_KEY=__multitool/db.json
SHORT_DOMAIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
VITE_RAZORPAY_KEY_ID=your_public_razorpay_key_id
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
VITE_API_URL=https://multitool-production-ddd8.up.railway.app
VITE_WORKER_SECRET=my_super_secret_123456
VITE_WA_SERVICE_URL=http://localhost:3002

# ── WhatsApp Service (whatsapp-service/.env) ─────────────────────────────
# URL of the Cloudflare Worker — whatsapp-service proxies all D1 ops through it
WA_WORKER_URL=http://localhost:8787
# Must match the x-wa-secret header checked in worker/src/index.js
WA_SHARED_SECRET=dev-local-secret
# Stable identifier for this WhatsApp session (used as D1 partition key)
WA_SESSION_ID=wa-tools
# Seconds before a pending chat triggers an SLA breach (default 15 min)
SLA_THRESHOLD_SECONDS=900
# How many chats / messages to backfill on first connect
INITIAL_MESSAGE_SYNC_CHATS=20
INITIAL_MESSAGE_SYNC_LIMIT=20
