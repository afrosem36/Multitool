{
  "name": "multi-tool-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml --inspector-port 0",
    "dev:remote": "wrangler dev --config wrangler.toml --remote",
    "deploy": "wrangler deploy --config wrangler.toml",
    "migrate": "wrangler d1 migrations apply multitool-db --remote --config wrangler.toml",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "hono": "^4.4.0",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "wrangler": "^4.87.0"
  }
}
