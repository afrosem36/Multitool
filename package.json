{
  "name": "multi-tool-web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "npm install && npm install --prefix worker && npm install --prefix youtube-service || echo 'YouTube service optional'",
    "dev": "concurrently --kill-others-on-fail --names client,worker,youtube --prefix-colors cyan,yellow,magenta \"npm run dev:client\" \"npm run dev:worker\" \"npm run dev:youtube\"",
    "dev:client": "vite",
    "dev:worker": "npm run dev --prefix worker",
    "dev:youtube": "node youtube-service/server.js",
    "prebuild": "node scripts/generate-seo-assets.mjs",
    "build": "vite build",
    "postbuild": "node scripts/generate-seo-assets.mjs",
    "deploy:frontend": "npm run build && npx vercel --prod",
    "deploy:worker": "npm run deploy --prefix worker",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@hello-pangea/dnd": "latest",
    "@heyputer/puter.js": "^2.3.2",
    "@pdfsmaller/pdf-encrypt-lite": "latest",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "docx": "^8.5.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.38.0",
    "heic2any": "^0.0.4",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "js-yaml": "^4.1.1",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.368.0",
    "lz-string": "^1.5.0",
    "mammoth": "^1.12.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.379",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.4",
    "react-hot-toast": "^2.4.1",
    "react-image-crop": "^11.0.10",
    "react-router-dom": "^6.22.3",
    "recharts": "^3.8.1",
    "sql.js": "^1.14.1",
    "styled-components": "^6.4.1",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.34.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "wrangler": "^4.86.0"
  }
}
