PORT=3001
# Comma-separated list of allowed origins (your frontend + Cloudflare Worker URL)
ALLOWED_ORIGINS=http://localhost:5173,https://multitoolhub.space
# Directory for temp files (defaults to OS temp dir)
TMP_DIR=
# Optional: full path to yt-dlp binary (auto-detected if in PATH)
YTDLP_PATH=
# Minutes before temp files are cleaned up
TEMP_TTL_MINUTES=5
