PORT=8080
# Comma-separated list of allowed origins (your frontend + Cloudflare Worker URL)
ALLOWED_ORIGINS=http://localhost:5173,https://multitoolhub.space
# Directory for temp files (defaults to OS temp dir)
TMP_DIR=
# Optional: full path to yt-dlp binary (auto-detected if in PATH)
YTDLP_PATH=
# Minutes before temp files are cleaned up (also job metadata TTL)
TEMP_TTL_MINUTES=10
# Shared secret — Worker sends this header, service validates it
WORKER_SECRET=your_secret
# Comma-separated proxy URLs. Leave empty for direct connection (no proxy).
# Format: http://user:pass@host:port,http://user:pass@host:port
PROXY_LIST=http://user:pass@proxy1:port,http://user:pass@proxy2:port,http://user:pass@proxy3:port,http://user:pass@proxy4:port,http://user:pass@proxy5:port,http://user:pass@proxy6:port
# Max simultaneous downloads running at once.
MAX_CONCURRENT=10
WORKERS=worker1,worker2,worker3
DOWNLOAD_RATE_LIMIT=5
RATE_WINDOW_MINUTES=10
AVERAGE_JOB_SECONDS_MIN=20
AVERAGE_JOB_SECONDS_MAX=60
JOB_TIMEOUT_MS=30000
MAX_JOB_RETRIES=3
